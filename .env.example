# Copy to .env (gitignored) and fill in real values.
#
# GitHub token used by the schema tools to raise the GitHub API rate limit
# when listing and caching HED schema versions. Optional: everything works
# without it, just with a lower unauthenticated rate limit.
# Either name is honored; HED_GITHUB_TOKEN wins if both are set.
HED_GITHUB_TOKEN=
GITHUB_TOKEN=
